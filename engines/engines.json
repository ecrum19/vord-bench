{
  "description": "Comunica engine configurations, derived from the fork's default config (baseConfig). replaceImports swaps imports of the base config; overrides are Components.js overrides; context is passed with every query. All engines run the same fork build, so they only differ in what is listed here. providedRestrictions marks the engines that read restrictions provided in the endpointRestrictions context entry (the VoRD engines); the others replace the fork's context-preprocess actors by the upstream ones, so that provided restrictions can never reach them.",
  "baseConfig": "engines/config-query-sparql/config/config-default-v5-4-1.json",
  "engines": {
    "A-naive": {
      "label": "Naive: no rate limiter, no retries, no VoRD",
      "replaceImports": {
        "ccqs:config/context-preprocess/actors-v5-4-1.json": [
          "ccqs:config/context-preprocess/actors.json"
        ],
        "ccqs:config/http/actors-v5-4-1.json": [
          "ccqs:config/http/actors-fetch-v5-1-3.json",
          "ccqs:config/http/actors-wayback.json"
        ],
        "ccqs:config/rdf-metadata-extract/actors-v5-4-1.json": [
          "ccqs:config/rdf-metadata-extract/actors-v5-3-0.json"
        ]
      },
      "context": {}
    },
    "B-backoff": {
      "label": "Comunica's current back-off: limit-rate and retries, no VoRD",
      "replaceImports": {
        "ccqs:config/context-preprocess/actors-v5-4-1.json": [
          "ccqs:config/context-preprocess/actors.json"
        ],
        "ccqs:config/http/actors-v5-4-1.json": [
          "ccqs:config/http/actors-fetch-v5-1-3.json",
          "ccqs:config/http/actors-limit-rate-v5-4-1.json",
          "ccqs:config/http/actors-wayback.json"
        ],
        "ccqs:config/rdf-metadata-extract/actors-v5-4-1.json": [
          "ccqs:config/rdf-metadata-extract/actors-v5-3-0.json"
        ]
      },
      "context": {
        "@comunica/bus-http:http-retry-count": 3,
        "@comunica/bus-http:http-retry-delay-fallback": 1000,
        "@comunica/bus-http:http-retry-delay-limit": 30000
      }
    },
    "Bp-backoff-eager": {
      "label": "B with limit-rate active from the first request (limitByDefault, correctionMultiplier 0.3, failureMultiplier 1)",
      "replaceImports": {
        "ccqs:config/context-preprocess/actors-v5-4-1.json": [
          "ccqs:config/context-preprocess/actors.json"
        ],
        "ccqs:config/http/actors-v5-4-1.json": [
          "ccqs:config/http/actors-fetch-v5-1-3.json",
          "ccqs:config/http/actors-limit-rate-v5-4-1.json",
          "ccqs:config/http/actors-wayback.json"
        ],
        "ccqs:config/rdf-metadata-extract/actors-v5-4-1.json": [
          "ccqs:config/rdf-metadata-extract/actors-v5-3-0.json"
        ]
      },
      "contexts": [
        "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/actor-http-limit-rate/^5.0.0/components/context.jsonld"
      ],
      "overrides": [
        {
          "@id": "urn:vord-bench:override:limit-rate",
          "@type": "Override",
          "overrideInstance": { "@id": "urn:comunica:default:http/actors#limit-rate" },
          "overrideSteps": [
            {
              "@type": "OverrideParameters",
              "overrideValue": {
                "@type": "ActorHttpLimitRate",
                "limitByDefault": true,
                "correctionMultiplier": 0.3,
                "failureMultiplier": 1
              }
            }
          ]
        }
      ],
      "context": {
        "@comunica/bus-http:http-retry-count": 3,
        "@comunica/bus-http:http-retry-delay-fallback": 1000,
        "@comunica/bus-http:http-retry-delay-limit": 30000
      }
    },
    "C-vord-http": {
      "label": "B plus VoRD at the HTTP layer only (restrictionAwarePlanning false)",
      "providedRestrictions": true,
      "contexts": [
        "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/actor-query-source-identify-hypermedia-sparql/^5.0.0/components/context.jsonld"
      ],
      "overrides": [
        {
          "@id": "urn:vord-bench:override:sparql",
          "@type": "Override",
          "overrideInstance": { "@id": "urn:comunica:default:query-source-identify-hypermedia/actors#sparql" },
          "overrideSteps": [
            {
              "@type": "OverrideParameters",
              "overrideValue": {
                "@type": "ActorQuerySourceIdentifyHypermediaSparql",
                "restrictionAwarePlanning": false
              }
            }
          ]
        }
      ],
      "context": {
        "@comunica/bus-http:http-retry-count": 3,
        "@comunica/bus-http:http-retry-delay-fallback": 1000,
        "@comunica/bus-http:http-retry-delay-limit": 30000
      }
    },
    "D-vord-full": {
      "label": "B plus VoRD at the HTTP layer and in planning and execution (the fork's default)",
      "providedRestrictions": true,
      "context": {
        "@comunica/bus-http:http-retry-count": 3,
        "@comunica/bus-http:http-retry-delay-fallback": 1000,
        "@comunica/bus-http:http-retry-delay-limit": 30000
      }
    }
  }
}
