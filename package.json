{
  "name": "vord-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark for Comunica's support of endpoint restrictions described with VoRD",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "setup": "bash suites/watdiv/setup.sh",
    "proxy": "node proxy/vord-proxy.mjs --config suites/watdiv/endpoints.json --profiles profiles",
    "generate-engines": "node harness/generate-engines.mjs",
    "queries": "node harness/generate-queries.mjs",
    "ground-truth": "node harness/ground-truth.mjs",
    "bench": "node harness/run.mjs",
    "bench:dry": "node harness/run.mjs --dry-run",
    "bench:smoke": "node harness/run.mjs --suite watdiv --preset smoke",
    "bench:regression": "node harness/run.mjs --suite watdiv --preset regression",
    "compare": "node harness/compare.mjs",
    "overhead": "node harness/overhead.mjs",
    "analyze": "node harness/analyze.mjs",
    "plot": "python3 harness/plot.py"
  }
}
