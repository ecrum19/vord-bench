{
  "id": "identified-email",
  "code": "I",
  "group": "access",
  "label": "an endpoint that requires an email address in From",
  "description": "Every request must carry the email address of the operator in the From header (RFC 9110); others get 403. Limits are counted per identity: 20 requests per 2 s, 10 in flight, 10,000 rows, 60 s. A client that switches identity is blocked for the rest of the run.",
  "basedOn": [
    {
      "source": "RFC 9110, section 10.1.2 (From)",
      "url": "https://www.rfc-editor.org/rfc/rfc9110#section-10.1.2",
      "retrieved": "2026-11-20"
    },
    {
      "source": "Wikimedia User-Agent policy",
      "url": "https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy",
      "retrieved": "2026-11-20"
    }
  ],
  "restrictions": [
    {
      "id": "identification",
      "type": "IdentificationRestriction",
      "identificationHeader": "from",
      "identificationFormat": "EmailAddress",
      "scope": "PerRequest",
      "enforcement": "RejectRequest",
      "hardRestriction": true,
      "returnsStatusCode": 403
    },
    {
      "id": "rate",
      "type": "RateRestriction",
      "metric": "requestsPerWindow",
      "maxValue": 20,
      "windowDuration": "PT2S",
      "unit": "COUNT",
      "scope": "PerUser",
      "enforcement": "RejectRequest",
      "hardRestriction": true,
      "returnsStatusCode": 429,
      "retryAfterHint": "PT1S",
      "httpSignalHeader": "retry-after"
    },
    {
      "id": "concurrency",
      "type": "ConcurrentRequestsRestriction",
      "metric": "concurrentRequests",
      "maxValue": 10,
      "unit": "COUNT",
      "scope": "PerUser",
      "enforcement": "RejectRequest",
      "hardRestriction": true,
      "returnsStatusCode": 429,
      "retryAfterHint": "PT1S"
    },
    {
      "id": "results",
      "type": "ResultSizeRestriction",
      "metric": "resultBindings",
      "maxValue": 10000,
      "unit": "COUNT",
      "scope": "PerRequest",
      "enforcement": "TruncateResult",
      "hardRestriction": true,
      "httpSignalHeader": "x-sparql-maxrows"
    },
    {
      "id": "timeout",
      "type": "ResponseTimeRestriction",
      "metric": "evaluationTime",
      "maxValue": 60,
      "unit": "SEC",
      "scope": "PerRequest",
      "enforcement": "RejectRequest",
      "hardRestriction": true,
      "returnsStatusCode": 503
    }
  ]
}
